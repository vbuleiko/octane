# Where the SQLite database and uploaded photos are stored (must be persistent on the server)
STORAGE_DIR=./storage

# Secret used to sign admin sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me

# First admin account, created by `npm run db:seed` (or `npm run admin:create`)
ADMIN_EMAIL=conrad@octaneauto.co.za
ADMIN_PASSWORD=change-me

# Public URL of the site, used for sitemap, Open Graph and structured data
SITE_URL=https://www.octaneauto.co.za
